  "steps": [
    {
      "text": "Heat the olive oil in a heavy-based pan and add the onion and carrot. Cook for 3\u20134 minutes until softened.",
      "technique": "saute",
      "uses": [
        "olive oil",
        "onion",
        "carrot"
      ]
    },
    {
      "text": "Add the diced lamb and brown all over.",
      "technique": "brown",
      "uses": [
        "lamb leg"
      ]
    },
    {
      "text": "Stir in the garlic and all the spices and cook for a few minutes more until the aromas are released.",
      "technique": "stir",
      "uses": [
        "garlic",
        "cumin",
        "ginger",
        "saffron",
        "cinnamon"
      ]
    },
    {
      "text": "Add the honey and apricots, crumble in the stock cube and pour over roughly 500 ml boiling water or enough to cover the meat. Stir well and bring to the boil.",
      "technique": "boil",
      "uses": [
        "honey",
        "apricot",
        "vegetable stock cube",
        "boiling water"
      ]
    },
    {
      "text": "Turn down to a simmer, put the lid on and cook for 1 hour.",
      "technique": "simmer",
      "uses": []
    },
    {
      "text": "Remove the lid and cook for a further 30 minutes, then stir in the butternut squash. Cook for 20\u201330 minutes more until the squash is soft and the lamb is tender.",
      "technique": "stir",
      "uses": [
        "butternut squash"
      ]
    },
    {
      "text": "Serve alongside couscous and sprinkle with parsley.",
      "technique": "serve",
      "uses": [
        "couscous",
        "parsley"
      ]
    }
  ]
