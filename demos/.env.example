# Copy to .env only if you want to RE-RECORD extractions from scratch.
# The notebooks run offline by default (they replay from demos/data/cache/),
# so no key is needed to run anything in this pack.

ANTHROPIC_API_KEY=

# Optional overrides (see demos/README.md):
# GRAPHTOOLS_LIVE=1            # ignore cache, call live, overwrite cache
# GRAPHTOOLS_CACHE=0           # pure passthrough — never read or write cache
# GRAPHTOOLS_MODEL=anthropic:claude-sonnet-4-6
